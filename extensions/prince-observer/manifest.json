{
  "manifest_version": 3,
  "name": "小王子消息观察器",
  "version": "1.2.2",
  "description": "仅读取当前打开页面已显示的益聊或 MX 消息，存档至本机。",
  "key": "",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1/*", "http://103.120.91.153/*", "https://mx.2026.naaifu.cn/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "查看小王子消息存档"
  },
  "content_scripts": [
    {
      "matches": [
        "http://103.120.91.153/*"
      ],
      "js": [
        "collector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://mx.2026.naaifu.cn/*"],
      "js": ["collector.js", "news-collector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
